# Copy to .env (git-ignored). Values here never override the shell.
# Gemini via AI Studio:
GOOGLE_API_KEY=
# ...or Gemini via Vertex (needs gcloud application-default credentials + billing):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global

# ClickHouse (local docker `locaish-ch`, or ClickHouse Cloud with CLICKHOUSE_SECURE=true)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_SECURE=false
CLICKHOUSE_PASSWORD=locaish

# The product layer (all optional).
# One passcode per deployment; share links, /pricing and /capture stay public.
# LOCAISH_PASSCODE=
# Pilot requests from /pricing are appended to <root>/_product/leads.jsonl and,
# when set, POSTed as JSON ({"text": ..., "lead": {...}}) to this webhook.
# LOCAISH_LEAD_WEBHOOK=
# Stripe payment links shown on /pricing; without them the buttons open the pilot form.
# LOCAISH_STRIPE_SCOUT_URL=
# LOCAISH_STRIPE_PRODUCTION_URL=
# LOCAISH_CONTACT_EMAIL=
